# Neon PostgreSQL
DATABASE_URL="postgres://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/socialhub?sslmode=require"

# Session & Token Encryption (AES-256)
AUTH_SECRET="your-32-byte-secret-key"

# Vercel Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token"

# Meta (Facebook & Instagram)
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"

# Meta Threads
THREADS_CLIENT_ID="your_threads_client_id"
THREADS_CLIENT_SECRET="your_threads_client_secret"

# X (Twitter)
X_CLIENT_ID="your_x_client_id"
X_CLIENT_SECRET="your_x_client_secret"

# Pinterest
PINTEREST_APP_ID="your_pinterest_app_id"
PINTEREST_APP_SECRET="your_pinterest_app_secret"

# Google (YouTube)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Vercel Cron Security & Scheduling
CRON_SECRET="your_secure_cron_secret_token"

# Public App URL for OAuth Callbacks
NEXT_PUBLIC_APP_URL="https://your-fubber-app.vercel.app"
